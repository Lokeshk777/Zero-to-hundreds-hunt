# Zero to Hundred's Hunt - Environment Configuration Template
# Copy this file to .env or set environment variables in your deployment host

# AI Text Generation (Google Gemini)
AI_TEXT_API_KEY=
AI_TEXT_MODEL=gemini-3.8-flash

# AI Image Generation (Hugging Face Free Inference API)
HUGGINGFACE_API_KEY=
AI_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# Storage Configuration
# Local development: LOCAL_DISK (writes to storage/story-visualizations/)
# Cloud production: CLOUD_OBJECT_STORAGE (e.g., S3/R2)
STORAGE_PROVIDER=LOCAL_DISK
STORAGE_BASE_PATH=storage/story-visualizations
SERVER_BASE_URL=

# Cloud Object Storage (Only required when STORAGE_PROVIDER=CLOUD_OBJECT_STORAGE)
CLOUD_STORAGE_BUCKET=
CLOUD_STORAGE_PUBLIC_URL=
